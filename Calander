<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>NASA Mission Log - Interactive Calendar</title>
  <!-- Google Fonts for futuristic/aerospace UI -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">

  <style>
    /* Global NASA & Deep Space Styling */
    :root {
      --space-bg: #060913;
      --card-bg: rgba(13, 20, 38, 0.85);
      --nasa-blue: #0b3d91;
      --nasa-red: #fc3d21;
      --glow-blue: #00d2ff;
      --hud-border: #1a365d;
      --text-main: #e2e8f0;
      --text-dim: #718096;
      --highlight: #ffd700;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--space-bg);
      background-image: 
        radial-gradient(1px 1px at 20px 30px, #ffffff, rgba(0,0,0,0)),
        radial-gradient(1.5px 1.5px at 100px 150px, #ffffff, rgba(0,0,0,0)),
        radial-gradient(1px 1px at 250px 80px, #00d2ff, rgba(0,0,0,0)),
        radial-gradient(2px 2px at 400px 300px, #ffffff, rgba(0,0,0,0)),
        radial-gradient(1px 1px at 600px 120px, #ffffff, rgba(0,0,0,0)),
        linear-gradient(180deg, #050811 0%, #0c1427 100%);
      background-repeat: repeat;
      background-size: 550px 550px, 100% 100%;
      color: var(--text-main);
      font-family: 'Rajdhani', sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px;
    }

    /* Header & HUD Styling */
    header {
      width: 100%;
      max-width: 1100px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 25px;
      margin-bottom: 20px;
      background: var(--card-bg);
      border: 1px solid var(--hud-border);
      border-left: 4px solid var(--nasa-red);
      border-radius: 6px;
      box-shadow: 0 0 20px rgba(0, 210, 255, 0.1);
      backdrop-filter: blur(8px);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .nasa-badge {
      background: var(--nasa-red);
      color: #fff;
      font-family: 'Orbitron', sans-serif;
      font-weight: 900;
      font-size: 1.2rem;
      letter-spacing: 2px;
      padding: 4px 10px;
      border-radius: 4px;
      text-shadow: 0 0 5px rgba(0,0,0,0.5);
    }

    h1 {
      font-family: 'Orbitron', sans-serif;
      font-size: 1.4rem;
      font-weight: 700;
      letter-spacing: 2px;
      color: #fff;
    }

    .status-panel {
      font-size: 0.9rem;
      color: var(--glow-blue);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    /* Main Container */
    .calendar-container {
      width: 100%;
      max-width: 1100px;
      background: var(--card-bg);
      border: 1px solid var(--hud-border);
      border-radius: 8px;
      box-shadow: 0 0 30px rgba(11, 61, 145, 0.3);
      backdrop-filter: blur(10px);
      padding: 25px;
    }

    /* Controls Bar */
    .controls {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .current-month-display {
      font-family: 'Orbitron', sans-serif;
      font-size: 1.6rem;
      color: #fff;
      text-shadow: 0 0 10px var(--glow-blue);
      letter-spacing: 2px;
    }

    .nav-btn {
      background: rgba(11, 61, 145, 0.4);
      border: 1px solid var(--glow-blue);
      color: #fff;
      padding: 8px 18px;
      font-family: 'Orbitron', sans-serif;
      font-size: 0.9rem;
      cursor: pointer;
      border-radius: 4px;
      transition: all 0.2s ease;
    }

    .nav-btn:hover {
      background: var(--glow-blue);
      color: #000;
      box-shadow: 0 0 12px var(--glow-blue);
    }

    /* Calendar Grid */
    .weekdays-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 8px;
      margin-bottom: 8px;
      text-align: center;
    }

    .weekday {
      font-family: 'Orbitron', sans-serif;
      font-size: 0.85rem;
      color: var(--glow-blue);
      padding: 8px 0;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .days-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 8px;
    }

    /* Day Cell */
    .day-cell {
      min-height: 105px;
      background: rgba(8, 14, 28, 0.7);
      border: 1px solid rgba(0, 210, 255, 0.15);
      border-radius: 4px;
      padding: 6px;
      display: flex;
      flex-direction: column;
      cursor: pointer;
      transition: all 0.2s ease;
      position: relative;
    }

    .day-cell:hover {
      border-color: var(--glow-blue);
      background: rgba(11, 61, 145, 0.25);
      transform: translateY(-2px);
    }

    .day-cell.inactive {
      opacity: 0.3;
      cursor: default;
    }

    .day-cell.today {
      border: 1px solid var(--nasa-red);
      box-shadow: inset 0 0 8px rgba(252, 61, 33, 0.4);
    }

    .day-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 4px;
    }

    .day-number {
      font-family: 'Orbitron', sans-serif;
      font-size: 0.85rem;
      font-weight: 700;
      color: #fff;
    }

    .day-cell.today .day-number {
      color: var(--nasa-red);
    }

    /* Task Items in Day Cell */
    .day-tasks {
      display: flex;
      flex-direction: column;
      gap: 3px;
      overflow-y: auto;
      max-height: 70px;
    }

    .task-badge {
      background: rgba(0, 210, 255, 0.15);
      border-left: 2px solid var(--glow-blue);
      font-size: 0.75rem;
      padding: 2px 4px;
      border-radius: 2px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      color: #e2e8f0;
    }

    .task-badge.priority-high {
      border-left-color: var(--nasa-red);
      background: rgba(252, 61, 33, 0.15);
    }

    /* Task Modal */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(2, 4, 10, 0.8);
      backdrop-filter: blur(5px);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 100;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
    }

    .modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    .modal {
      background: #0b1220;
      border: 1px solid var(--glow-blue);
      border-radius: 8px;
      width: 90%;
      max-width: 480px;
      padding: 25px;
      box-shadow: 0 0 25px rgba(0, 210, 255, 0.3);
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      border-bottom: 1px solid var(--hud-border);
      padding-bottom: 10px;
    }

    .modal-title {
      font-family: 'Orbitron', sans-serif;
      font-size: 1.1rem;
      color: #fff;
    }

    .close-btn {
      background: none;
      border: none;
      color: var(--text-dim);
      font-size: 1.4rem;
      cursor: pointer;
    }

    .close-btn:hover {
      color: #fff;
    }

    /* Modal Form */
    .task-input-group {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 20px;
    }

    .task-input-group input,
    .task-input-group select {
      background: rgba(16, 26, 48, 0.8);
      border: 1px solid var(--hud-border);
      padding: 10px;
      color: #fff;
      font-family: 'Rajdhani', sans-serif;
      font-size: 1rem;
      border-radius: 4px;
      outline: none;
    }

    .task-input-group input:focus,
    .task-input-group select:focus {
      border-color: var(--glow-blue);
      box-shadow: 0 0 8px rgba(0, 210, 255, 0.4);
    }

    .add-task-btn {
      background: var(--nasa-red);
      color: #fff;
      border: none;
      padding: 10px;
      font-family: 'Orbitron', sans-serif;
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      border-radius: 4px;
      letter-spacing: 1px;
      transition: background 0.2s ease;
    }

    .add-task-btn:hover {
      background: #e02f15;
    }

    /* Modal Task List */
    .modal-task-list {
      max-height: 180px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .modal-task-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(16, 26, 48, 0.5);
      border: 1px solid var(--hud-border);
      padding: 8px 12px;
      border-radius: 4px;
    }

    .task-info {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .task-priority-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--glow-blue);
    }

    .task-priority-dot.high {
      background: var(--nasa-red);
      box-shadow: 0 0 5px var(--nasa-red);
    }

    .delete-task-btn {
      background: none;
      border: none;
      color: var(--text-dim);
      font-size: 1rem;
      cursor: pointer;
    }

    .delete-task-btn:hover {
      color: var(--nasa-red);
    }
  </style>
</head>
<body>

  <!-- Top NASA Header -->
  <header>
    <div class="brand">
      <div class="nasa-badge">NASA</div>
      <h1>MISSION SCHEDULE INTERFACE</h1>
    </div>
    <div class="status-panel">
      <span>● SYSTEM ONLINE</span>
    </div>
  </header>

  <!-- Calendar Container -->
  <main class="calendar-container">
    <div class="controls">
      <button class="nav-btn" id="prev-month">< PREV</button>
      <div class="current-month-display" id="month-display">OCTOBER 2026</div>
      <button class="nav-btn" id="next-month">NEXT ></button>
    </div>

    <!-- Weekday Labels -->
    <div class="weekdays-grid">
      <div class="weekday">SUN</div>
      <div class="weekday">MON</div>
      <div class="weekday">TUE</div>
      <div class="weekday">WED</div>
      <div class="weekday">THU</div>
      <div class="weekday">FRI</div>
      <div class="weekday">SAT</div>
    </div>

    <!-- Calendar Days Grid -->
    <div class="days-grid" id="days-container"></div>
  </main>

  <!-- Interactive Mission Log / Task Modal -->
  <div class="modal-overlay" id="task-modal">
    <div class="modal">
      <div class="modal-header">
        <h2 class="modal-title" id="modal-date-title">LOG ENTRY: YYYY-MM-DD</h2>
        <button class="close-btn" id="close-modal">&times;</button>
      </div>

      <!-- Add New Task Form -->
      <form id="task-form" class="task-input-group">
        <input type="text" id="task-desc" placeholder="Enter mission directive / task..." required autocomplete="off" />
        <select id="task-priority">
          <option value="normal">Standard Priority</option>
          <option value="high">Critical (Launch Priority)</option>
        </select>
        <button type="submit" class="add-task-btn">+ ADD DIRECTIVE</button>
      </form>

      <!-- Existing Tasks for Day -->
      <div class="modal-task-list" id="modal-tasks-container"></div>
    </div>
  </div>

  <script>
    // State management
    let currentDate = new Date();
    let selectedDateKey = null;

    // Load stored tasks from LocalStorage or initialize an empty structure
    let tasks = JSON.parse(localStorage.getItem('nasa_mission_tasks')) || {};

    // DOM Elements
    const monthDisplay = document.getElementById('month-display');
    const daysContainer = document.getElementById('days-container');
    const prevBtn = document.getElementById('prev-month');
    const nextBtn = document.getElementById('next-month');
    const modal = document.getElementById('task-modal');
    const closeModal = document.getElementById('close-modal');
    const modalDateTitle = document.getElementById('modal-date-title');
    const taskForm = document.getElementById('task-form');
    const taskDescInput = document.getElementById('task-desc');
    const taskPriorityInput = document.getElementById('task-priority');
    const modalTasksContainer = document.getElementById('modal-tasks-container');

    const monthNames = [
      "JANUARY", "FEBRUARY", "MARCH", "APRIL", "MAY", "JUNE",
      "JULY", "AUGUST", "SEPTEMBER", "OCTOBER", "NOVEMBER", "DECEMBER"
    ];

    // Helper: Save tasks to LocalStorage
    function saveTasks() {
      localStorage.setItem('nasa_mission_tasks', JSON.stringify(tasks));
    }

    // Helper: Format Date Key (YYYY-MM-DD)
    function formatDateKey(year, month, day) {
      const m = String(month + 1).padStart(2, '0');
      const d = String(day).padStart(2, '0');
      return `${year}-${m}-${d}`;
    }

    // Render the Calendar Grid
    function renderCalendar() {
      const year = currentDate.getFullYear();
      const month = currentDate.getMonth();

      monthDisplay.textContent = `${monthNames[month]} ${year}`;
      daysContainer.innerHTML = '';

      // Determine day ranges
      const firstDayIndex = new Date(year, month, 1).getDay();
      const totalDays = new Date(year, month + 1, 0).getDate();
      const prevMonthTotalDays = new Date(year, month, 0).getDate();

      const today = new Date();

      // Render Previous Month Padding Days
      for (let i = firstDayIndex - 1; i >= 0; i--) {
        const dayDiv = document.createElement('div');
        dayDiv.className = 'day-cell inactive';
        dayDiv.innerHTML = `<span class="day-number">${prevMonthTotalDays - i}</span>`;
        daysContainer.appendChild(dayDiv);
      }

      // Render Current Month Active Days
      for (let day = 1; day <= totalDays; day++) {
        const dayDiv = document.createElement('div');
        dayDiv.className = 'day-cell';

        const dateKey = formatDateKey(year, month, day);

        // Highlight today
        if (
          day === today.getDate() &&
          month === today.getMonth() &&
          year === today.getFullYear()
        ) {
          dayDiv.classList.add('today');
        }

        const headerDiv = document.createElement('div');
        headerDiv.className = 'day-header';
        headerDiv.innerHTML = `<span class="day-number">${day}</span>`;
        dayDiv.appendChild(headerDiv);

        // Container for mission task indicators
        const taskListDiv = document.createElement('div');
        taskListDiv.className = 'day-tasks';

        if (tasks[dateKey] && tasks[dateKey].length > 0) {
          tasks[dateKey].forEach(task => {
            const badge = document.createElement('div');
            badge.className = `task-badge ${task.priority === 'high' ? 'priority-high' : ''}`;
            badge.textContent = task.text;
            taskListDiv.appendChild(badge);
          });
        }

        dayDiv.appendChild(taskListDiv);

        // Open task modal on click
        dayDiv.addEventListener('click', () => openTaskModal(dateKey, year, month, day));

        daysContainer.appendChild(dayDiv);
      }

      // Render Next Month Padding Days to complete the 7-column layout
      const totalRendered = firstDayIndex + totalDays;
      const nextDays = (7 - (totalRendered % 7)) % 7;
      for (let i = 1; i <= nextDays; i++) {
        const dayDiv = document.createElement('div');
        dayDiv.className = 'day-cell inactive';
        dayDiv.innerHTML = `<span class="day-number">${i}</span>`;
        daysContainer.appendChild(dayDiv);
      }
    }

    // Modal Operations
    function openTaskModal(dateKey, year, month, day) {
      selectedDateKey = dateKey;
      modalDateTitle.textContent = `DIRECTIVES: ${monthNames[month]} ${day}, ${year}`;
      renderModalTasks();
      modal.classList.add('active');
      taskDescInput.focus();
    }

    function closeModalHandler() {
      modal.classList.remove('active');
      taskDescInput.value = '';
      selectedDateKey = null;
    }

    function renderModalTasks() {
      modalTasksContainer.innerHTML = '';
      const dayTasks = tasks[selectedDateKey] || [];

      if (dayTasks.length === 0) {
        modalTasksContainer.innerHTML = '<p style="color: var(--text-dim); font-size: 0.9rem;">No scheduled directives for this sol.</p>';
        return;
      }

      dayTasks.forEach((task, index) => {
        const item = document.createElement('div');
        item.className = 'modal-task-item';

        const info = document.createElement('div');
        info.className = 'task-info';

        const dot = document.createElement('span');
        dot.className = `task-priority-dot ${task.priority === 'high' ? 'high' : ''}`;

        const text = document.createElement('span');
        text.textContent = task.text;

        info.appendChild(dot);
        info.appendChild(text);

        const deleteBtn = document.createElement('button');
        deleteBtn.className = 'delete-task-btn';
        deleteBtn.innerHTML = '&times;';
        deleteBtn.title = 'Abort Directive';
        deleteBtn.addEventListener('click', () => deleteTask(index));

        item.appendChild(info);
        item.appendChild(deleteBtn);
        modalTasksContainer.appendChild(item);
      });
    }

    // Task Actions
    function addTask(e) {
      e.preventDefault();
      const text = taskDescInput.value.trim();
      const priority = taskPriorityInput.value;

      if (!text || !selectedDateKey) return;

      if (!tasks[selectedDateKey]) {
        tasks[selectedDateKey] = [];
      }

      tasks[selectedDateKey].push({ text, priority });
      saveTasks();
      taskDescInput.value = '';

      renderModalTasks();
      renderCalendar();
    }

    function deleteTask(index) {
      if (!selectedDateKey || !tasks[selectedDateKey]) return;
      tasks[selectedDateKey].splice(index, 1);
      
      if (tasks[selectedDateKey].length === 0) {
        delete tasks[selectedDateKey];
      }

      saveTasks();
      renderModalTasks();
      renderCalendar();
    }

    // Event Listeners
    prevBtn.addEventListener('click', () => {
      currentDate.setMonth(currentDate.getMonth() - 1);
      renderCalendar();
    });

    nextBtn.addEventListener('click', () => {
      currentDate.setMonth(currentDate.getMonth() + 1);
      renderCalendar();
    });

    closeModal.addEventListener('click', closeModalHandler);
    taskForm.addEventListener('submit', addTask);

    window.addEventListener('click', (e) => {
      if (e.target === modal) closeModalHandler();
    });

    // Initialize calendar
    renderCalendar();
  </script>
</body>
</html>